# Testrix — root environment variables. Copy to `.env` (gitignored) and fill in real values
# before running `docker compose up -d --build` from the repo root.
#
# Generate a strong random value for any secret below with, e.g.:
#   openssl rand -base64 32

# --- Shared MySQL (platform/docker-compose.yml) ---
# Root password for the shared testrix-mysql container. Required — no insecure fallback.
MYSQL_ROOT_PASSWORD=

# --- automation-portal auth/security ---
# HMAC signing secret for login JWTs, shared with api-testing/performance-testing/genai so
# they can validate the same tokens. Required — the app now fails to start without it.
# Rotating this logs out every active session platform-wide (expected, not a bug).
PORTAL_JWT_SECRET=
# Password for the seeded superadmin@gmail.com account, applied only the first time that
# account is created (a database that already has the account is unaffected).
PORTAL_SUPERADMIN_SEED_PASSWORD=
# Shared secret the execution-manager/runner use to call automation-portal's execution-event
# webhook. Required — no insecure fallback.
PORTAL_EVENTS_API_KEY=

# --- api-testing ---
# AES-256-GCM key (base64, 32 bytes) used to encrypt stored collection credentials at rest.
# Required — no insecure fallback. Changing this value makes every already-encrypted
# credential permanently undecryptable; only change it as part of a deliberate, planned
# re-encryption migration, never casually.
APITESTING_ENCRYPTION_KEY=

# --- Automation module framework source ---
# Host paths to the two external test-framework repos (MPHIDB / playwright-js), bind-mounted
# into the automation-portal backend and automation-framework-runner containers at runtime.
# Point these at wherever those repos are checked out on the machine/CI running this compose
# project.
AUTOMATION_FRAMEWORK_REPO_PATH=
AUTOMATION_PLAYWRIGHT_PATH=

# --- genai (products/genai/service/.env — its own file, not this one) ---
# GROQ_API_KEY=
# TAVILY_API_KEY=
